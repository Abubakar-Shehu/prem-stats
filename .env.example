# Leave VITE_URL empty to use same-origin API routes
# (Vite middleware in development, Vercel functions in production).
VITE_URL=

# Optional: existing Fly auth backend (used for /auth proxy only)
VITE_PROXY_TARGET=https://backend-nkn2pg.fly.dev

# Optional: Football-Data.org token. When set, season requests use that API.
# When unset, the app falls back to openfootball JSON for historical seasons.
FOOTBALL_DATA_API_KEY=

# Optional: only needed if calling Supabase directly from the client
VITE_SUPABASE_URL=supabase_url
VITE_SUPABASE_ANON_KEY=supabase_anon_key
