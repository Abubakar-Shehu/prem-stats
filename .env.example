# Leave VITE_URL empty to call the backend through the same-origin proxy
# (Vite in development, Vercel rewrites in production). This avoids CORS
# failures when requests use credentials: "include".
VITE_URL=

# Optional override for the proxy target (Vite only)
VITE_PROXY_TARGET=https://backend-nkn2pg.fly.dev

# Optional: only needed if calling Supabase directly from the client
VITE_SUPABASE_URL=supabase_url
VITE_SUPABASE_ANON_KEY=supabase_anon_key
