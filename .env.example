# Leave VITE_URL empty (same-origin /api and /auth).
# Do NOT set this to the Fly auth host — that breaks CORS and prem data.
# Vite proxies /auth and Vercel rewrites /auth → Fly automatically.
VITE_URL=

# Fly auth backend target for the Vite /auth proxy (and Vercel rewrite docs)
VITE_PROXY_TARGET=https://backend-nkn2pg.fly.dev

# Optional: Football-Data.org token. When set, season team/table/match
# requests prefer that API. When unset, openfootball JSON is used.
FOOTBALL_DATA_API_KEY=

# Optional: only needed if calling Supabase directly from the client
VITE_SUPABASE_URL=supabase_url
VITE_SUPABASE_ANON_KEY=supabase_anon_key
